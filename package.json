{
  "name": "hematku-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "HematKu - Full-stack Personal Finance Tracker (Clean Architecture + pnpm)",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "start:backend": "pnpm --filter backend start",
    "build:frontend": "pnpm --filter frontend build"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
